{
  "name": "Workflo",
  "version": "1.0.0",
  "tagline": "Wij zijn de IT-afdeling van je bedrijf",
  "tone": "NL, no-nonsense, warm/direct. No vendor names, no superlatives.",
  "colors": {
    "wf-yellow": {
      "value": "#F2F400",
      "usage": "Primary accent. Scarce — max 1–2 elements per view. SocialKaart may be full yellow."
    },
    "wf-yellow-ink": {
      "value": "#DADA00",
      "usage": "Yellow ink / pressed / darker yellow detail."
    },
    "wf-yellow-tint": {
      "value": "#FAFBC2",
      "usage": "Soft yellow tint backgrounds only."
    },
    "wf-black": {
      "value": "#0A0A0A",
      "usage": "Primary black, hard shadows, display text."
    },
    "wf-ink": {
      "value": "#1A1A1A",
      "usage": "Body text on light."
    },
    "wf-graphite": {
      "value": "#2B2B2B",
      "usage": "Dark panels, secondary surfaces."
    },
    "wf-steel": {
      "value": "#5C5C5C",
      "usage": "Secondary text."
    },
    "wf-fog": {
      "value": "#6B6B6B",
      "usage": "Muted / captions. NOT #9A9A9A."
    },
    "wf-mist": {
      "value": "#D6D6D6",
      "usage": "Borders, hairlines."
    },
    "wf-bone": {
      "value": "#EFEFEF",
      "usage": "Subtle surface alternate."
    },
    "wf-paper": {
      "value": "#F7F7F5",
      "usage": "Default page background."
    },
    "wf-white": {
      "value": "#FFFFFF",
      "usage": "Cards, wordmark on dark."
    },
    "wf-cyber": {
      "value": "#00FF88",
      "usage": "Cyber series ONLY. Label as cyber domain. Sparingly."
    }
  },
  "forbidden": [
    "#0A1628",
    "#FFD700",
    "#9A9A9A"
  ],
  "rules": [
    "Text on yellow (#F2F400) must be black (#0A0A0A) only — never white on yellow.",
    "Yellow accent is scarce (1–2 elements) unless SocialKaart full-yellow.",
    "Hard shadow: 6px 6px 0 #0A0A0A (or yellow on dark). No blur.",
    "Radius max 4px; prefer square (0).",
    "Font: Navigo only (self-hosted). Display Black 900 tight; eyebrow Bold uppercase + tracking.",
    "Never navy #0A1628 or gold #FFD700.",
    "No publish/upload to production without Florian's explicit yes."
  ],
  "typography": {
    "family": "Navigo",
    "files": {
      "black": "fonts/Navigo-Black.woff2",
      "bold": "fonts/Navigo-Bold.woff2",
      "medium": "fonts/Navigo-Medium.woff2"
    },
    "display": {
      "weight": 900,
      "tracking": "-0.02em"
    },
    "eyebrow": {
      "weight": 700,
      "tracking": "0.16em",
      "transform": "uppercase"
    },
    "cta": {
      "weight": 700,
      "tracking": "0.04em"
    }
  },
  "form": {
    "radius": "0px",
    "radiusMax": "4px",
    "shadowHard": "6px 6px 0 #0A0A0A",
    "shadowHardYellow": "6px 6px 0 #F2F400"
  },
  "logos": {
    "horizontalBlack": "logos/logo-horizontal-black.png",
    "horizontalYellowMark": "logos/logo-horizontal-yellow-mark.png",
    "horizontalOnDark": "logos/logo-horizontal-on-dark.png",
    "markBlack": "logos/mark-black.png",
    "markOnDark": "logos/mark-on-dark.png",
    "markYellowOnBlack": "logos/mark-yellow-on-black.png",
    "verticalBlack": "logos/logo-vertical-black.png",
    "verticalYellowMark": "logos/logo-vertical-yellow-mark.png"
  },
  "cssImport": "tokens/tokens.css"
}
