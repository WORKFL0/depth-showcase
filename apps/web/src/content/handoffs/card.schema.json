{
  "$id": "https://workflo.local/depth-showcase/handoff-card.schema.json",
  "type": "object",
  "required": ["agent", "kind", "version", "sourcePath", "card", "display"],
  "properties": {
    "agent": { "type": "string" },
    "agentId": { "type": "string" },
    "role": { "type": "string" },
    "kind": { "const": "handoff-card" },
    "version": { "type": "integer", "minimum": 1 },
    "sourcePath": { "type": "string" },
    "card": {
      "type": "object",
      "required": ["title", "date", "slug", "summary", "status"],
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "slug": { "type": "string" },
        "summary": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "shipped", "open"] },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "openItems": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "display": {
      "type": "object",
      "required": ["eyebrow", "accent", "surface"],
      "properties": {
        "eyebrow": { "type": "string" },
        "accent": { "type": "string" },
        "surface": { "type": "string" }
      }
    }
  }
}
